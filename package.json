{
    "name": "spotfire-spider-chart-mod",
    "version": "1.0.1",
    "description": "",
    "type": "module",
    "scripts": {
        "build": "webpack --mode production --devtool false",
        "build:dev": "webpack --mode development --watch",
        "tsc:dev": "tsc --watch",
        "server": "mods-dev-server dist",
        "dev": "concurrently \"npm:build:dev\" \"npm:server\"",
        "sbom": "node -e \"const args=process.argv.slice(1).join(' ');require('fs').writeFileSync(`${process.env.npm_package_name}-${process.env.npm_package_version}-sbom.spdx.json`, require('child_process').execSync(`npm sbom --sbom-format=spdx --omit=dev ${args}`))\" --",
        "sbom:all": "node -e \"const args=process.argv.slice(1).join(' ');require('fs').writeFileSync(`${process.env.npm_package_name}-${process.env.npm_package_version}-sbom.spdx.json`, require('child_process').execSync(`npm sbom --sbom-format=spdx ${args}`))\" --"
    },
    "author": "cnicolet, dhategan, valexand",
    "license": "ISC",
    "dependencies": {
        "d3": "^7.9.0",
        "events": "^3.3.0"
    },
    "devDependencies": {
        "@spotfire/mods-api": "~1.3.0",
        "@spotfire/mods-dev-server": "^1.2.0",
        "@types/d3": "^7.4.3",
        "concurrently": "^9.2.0",
        "copy-webpack-plugin": "^13.0.0",
        "prettier": "^3.3.0",
        "ts-loader": "9.2.8",
        "typescript": "^5.8.2",
        "webpack": "^5.99.0",
        "webpack-cli": "^6.0.1"
    }
}
